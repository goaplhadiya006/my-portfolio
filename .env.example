# Resend API key. Keep this server-side; never use a VITE_ prefix.
RESEND_API_KEY="re_your_resend_api_key"

# Optional: defaults to the portfolio email address.
CONTACT_TO_EMAIL=""

# Optional for Resend account testing. For public production, use a sender
# address on a domain verified in Resend.
CONTACT_FROM_EMAIL=""

